# Configure in the Railway API service, never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_DB_URL=postgresql://signalgen_api.project-ref:encoded-password@session-pooler-host:5432/postgres?sslmode=require
SIGNALGEN_MARKET_DATA_MODE=postgres_archive
SIGNALGEN_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SIGNALGEN_PASSWORD_RESET_REDIRECT_URL=http://localhost:5174/?view=reset-password
# Leave SIGNALGEN_GO_API_ADDR unset; Railway supplies PORT.
SIGNALGEN_REDIS_URL=redis://default:${{market-cache.REDIS_PASSWORD}}@${{market-cache.RAILWAY_PRIVATE_DOMAIN}}:6379/0
SIGNALGEN_REDIS_NAMESPACE=signalgen-railway
GOMEMLIMIT=160MiB
MIDTRANS_IS_PRODUCTION=false
# Never add SIGNALGEN_MARKET_WRITER_URL or SUPABASE_ADMIN_DB_URL here.
