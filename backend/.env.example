SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_DB_URL=postgresql://postgres.project-ref:your-encoded-password@your-session-pooler-host:5432/postgres?sslmode=require
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# Legacy Python profile only; the active Go API uses Supabase Postgres.
SIGNALGEN_DB_PATH=/workspace/backend/runtime/signalgen.db

# Active Go API. Database credentials stay in this server-only environment.
SIGNALGEN_GO_API_ADDR=:8080

# Exact comma-separated web origins allowed to call the Go API from a browser.
# Include the exact Vite origin used by the web frontend.
SIGNALGEN_CORS_ORIGINS=http://127.0.0.1:5174
# Must also be allowlisted under Supabase Auth redirect URLs.
SIGNALGEN_PASSWORD_RESET_REDIRECT_URL=http://127.0.0.1:5174/?view=reset-password
SIGNALGEN_MAX_ACTIVE_SESSIONS=1
SIGNALGEN_DEVICE_SWITCH_COOLDOWN_HOURS=24
SIGNALGEN_MUTATION_RATE_LIMIT_PER_MINUTE=60
