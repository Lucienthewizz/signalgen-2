SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Docker stores SQLite in its persistent runtime volume.
SIGNALGEN_DB_PATH=/workspace/backend/runtime/signalgen.db

# Target Go API (optional while the Python backend remains active).
SIGNALGEN_GO_API_ADDR=:8080
SIGNALGEN_GO_DB_PATH=/data/signalgen-go.db
SIGNALGEN_FIXTURE_PATH=/usr/share/signalgen/fixtures/default_scalping_v1.json

# Exact comma-separated web origins allowed to call the Go API from a browser.
# Keep empty when only Electron/server-side clients use the API.
SIGNALGEN_CORS_ORIGINS=http://localhost:5173
SIGNALGEN_MAX_ACTIVE_SESSIONS=3
