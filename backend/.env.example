SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Docker stores SQLite in its persistent runtime volume.
SIGNALGEN_DB_PATH=/workspace/backend/runtime/signalgen.db

# Target Go API (optional while the Python backend remains active).
SIGNALGEN_GO_API_ADDR=:8080
SIGNALGEN_GO_DB_PATH=/data/signalgen-go.db
