SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# HTTP runtime only. Provision signalgen_api after applying migrations.
# Never give the runtime the postgres migration connection.
SUPABASE_DB_URL=postgresql://signalgen_api.project-ref:your-encoded-runtime-password@your-session-pooler-host:5432/postgres?sslmode=require
# Migration/admin URL must live in a separate local/deployment secret, not in
# the API container environment. Set SUPABASE_ADMIN_DB_URL only for admin CLI.
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# Optional public OHLCV cache. Empty disables Redis; RAM/provider fallback remains.
# Compose overrides this with its private cache service. For Railway use its
# Redis connection variable; use rediss:// for an external TLS endpoint.
SIGNALGEN_REDIS_URL=
SIGNALGEN_REDIS_NAMESPACE=signalgen

# Legacy Python profile only; the active Go API uses Supabase Postgres.
SIGNALGEN_DB_PATH=/workspace/backend/runtime/signalgen.db

# Active Go API. Database credentials stay in this server-only environment.
SIGNALGEN_GO_API_ADDR=:8080

# Exact comma-separated web origins allowed to call the Go API from a browser.
# Include the exact Vite origin used by the web frontend.
SIGNALGEN_CORS_ORIGINS=http://127.0.0.1:5174
# Must also be allowlisted under Supabase Auth redirect URLs.
SIGNALGEN_PASSWORD_RESET_REDIRECT_URL=http://127.0.0.1:5174/?view=reset-password
SIGNALGEN_MAX_ACTIVE_SESSIONS=1
SIGNALGEN_DEVICE_SWITCH_COOLDOWN_HOURS=24
SIGNALGEN_MUTATION_RATE_LIMIT_PER_MINUTE=60
# Concurrent authenticated WebSockets (process-local MVP safety bounds).
SIGNALGEN_MAX_SCREENER_CONNECTIONS=32
SIGNALGEN_MAX_SCREENER_CONNECTIONS_PER_USER=2

# Midtrans Snap payments (sandbox while MIDTRANS_IS_PRODUCTION=false).
# Server Key from Midtrans Settings -> Access Keys; needs Snap Checkout: Write
# and Core API: Read. Leave empty to disable checkout.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
